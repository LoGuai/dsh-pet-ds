    "dev": "node scripts/dev/mock-host.mjs",
    "dev:debug": "node scripts/dev/mock-host.mjs --debug",
    "probe": "node scripts/dev/probe.mjs",
    "test": "node scripts/dev/test-changelog.mjs && node scripts/dev/test-changelog-canary.mjs && node scripts/dev/test-animations.mjs && node scripts/dev/test-manifest-deps.mjs && node scripts/dev/test-config-schema.mjs && node scripts/dev/test-client-settings.mjs && node scripts/dev/test-client-smoke.mjs && node --experimental-vm-modules scripts/dev/test-host-link.mjs && node --experimental-vm-modules scripts/dev/test-install-bundle-spec.mjs && node scripts/dev/test-install.mjs && node scripts/dev/test-setup-extract.mjs && node scripts/dev/test-setup-upgrade.mjs && node scripts/dev/check-cmd-ascii.mjs && node scripts/dev/test-install-ps1.mjs && node scripts/dev/test-install-ps1-unresolvable.mjs && node scripts/dev/test-doubleclick.mjs && node scripts/dev/test-voice-library.mjs && node scripts/dev/test-voice-sources.mjs && node scripts/dev/test-work-status.mjs && node scripts/dev/test-dialogue.mjs && node scripts/dev/test-balance-announce.mjs && node scripts/dev/test-mood.mjs && node scripts/dev/test-affection.mjs && node scripts/dev/test-affection-gain.mjs && node scripts/dev/test-affection-store.mjs",
    "verify:install-bundle": "node scripts/dev/verify-install-bundle.mjs",
    "build:installer": "node scripts/dev/build-installer.mjs",
    "test:setup": "node scripts/dev/test-setup-extract.mjs && node scripts/dev/test-setup-pnpm.mjs",
    "sign:installer": "node scripts/dev/sign-installer.mjs",
    "probe:balance": "node scripts/dev/probe-balance-live.mjs",
    "probe:refresh": "node scripts/dev/probe-balance-refresh.mjs",
    "test:changelog": "node scripts/dev/test-changelog.mjs"
  },
